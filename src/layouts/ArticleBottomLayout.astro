---
import { type CollectionEntry, getCollection } from "astro:content"
import Gallery from "@components/Gallery.astro"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content, headings } = await entry.render()
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <div id="read-progress" aria-hidden="true" class="fixed top-0 inset-x-0 h-0.5 z-[60] origin-left bg-gradient-to-r from-sky-400 to-indigo-500" style="transform: scaleX(var(--progress, 0))"></div>

  {toc.length >= 3 &&
    <details id="toc" class="card p-4 mb-8 xl:fixed xl:top-36 xl:left-[max(1rem,calc(50%-24rem-17rem))] xl:w-60 xl:mb-0 xl:max-h-[70vh] xl:overflow-auto">
      <summary class="cursor-pointer text-sm font-semibold uppercase text-black dark:text-white">On this page</summary>
      <ul class="mt-3 space-y-1.5 text-sm">
        {toc.map(h => (
          <li class:list={[h.depth === 3 && "pl-3"]}>
            <a href={`#${h.slug}`} data-toc={h.slug} class="block opacity-70 hover:opacity-100 hover:text-black dark:hover:text-white blend">{h.text}</a>
          </li>
        ))}
      </ul>
    </details>
  }

  {entry.collection === "projects" && !!entry.data.gallery?.length &&
    <Gallery images={entry.data.gallery} title={entry.data.title} />
  }
  <article>
    <Content/>
  </article>
  {items.length > 1 &&
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href={`/${prev.collection}/${prev.slug}`} class="group card card-hover p-4 gap-3 flex items-center">
      <div class="order-2 w-full h-full group-hover:text-black group-hover:dark:text-white blend">
        <div class="flex flex-wrap gap-2">
          <div class="text-sm uppercase">
            Prev
          </div>
        </div>
        <div class="font-semibold mt-3 text-black dark:text-white">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-black group-hover:dark:stroke-white rotate-180">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
    <a href={`/${next.collection}/${next.slug}`} class="group card card-hover p-4 gap-3 flex items-center">
      <div class="w-full h-full text-right group-hover:text-black group-hover:dark:text-white blend">
        <div class="text-sm uppercase">
          Next
        </div>
        <div class="font-semibold mt-3 text-black dark:text-white">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
  </div>
  }
</div>

<style>
  [data-toc].active {
    @apply opacity-100 font-semibold text-sky-700 dark:text-sky-300;
  }
</style>

<script>
  // Reading progress bar.
  const bar = document.getElementById("read-progress")!
  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight
    bar.style.setProperty("--progress", String(max > 0 ? window.scrollY / max : 0))
  }
  window.addEventListener("scroll", updateProgress, { passive: true })
  updateProgress()

  // Table of contents: open on wide screens, highlight the section being read.
  const toc = document.getElementById("toc") as HTMLDetailsElement | null
  if (toc) {
    if (window.matchMedia("(min-width: 1280px)").matches) toc.open = true
    const links = new Map([...toc.querySelectorAll<HTMLElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]))
    const observer = new IntersectionObserver((entries) => {
      entries.filter((e) => e.isIntersecting).forEach((e) => {
        links.forEach((link) => link.classList.remove("active"))
        links.get(e.target.id)?.classList.add("active")
      })
    }, { rootMargin: "0px 0px -70% 0px" })
    links.forEach((_, id) => {
      const heading = document.getElementById(id)
      if (heading) observer.observe(heading)
    })
  }
</script>
