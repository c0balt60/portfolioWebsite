---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
const { title, description } = Astro.props
import { SITE } from "@consts"

// Page content lifts out and settles in; the header stays put.
const anim = { old: { name: "page-out", duration: "0.25s", easing: "ease-in", fillMode: "both" }, new: { name: "page-in", duration: "0.45s", easing: "cubic-bezier(0.22, 1, 0.36, 1)", fillMode: "both" } }
const pageTransition = { forwards: anim, backwards: anim }
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <Drawer />
    <main transition:animate={pageTransition} class="bg-gradient-to-b from-blue-300 dark:from-indigo-950 to-white dark:to-black">
      <slot />
    </main>
    <Footer />
  </body>
</html>
