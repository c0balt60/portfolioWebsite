---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Projects from "@components/Projects"
import Skeleton from "@components/Skeleton.astro"
import { PROJECTS } from "@consts"
import { toProjectCard } from "@lib/projects"

const entries = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const projects = await Promise.all(entries.map(toProjectCard))

const tags = [...new Set(projects.flatMap(project => project.tags))]
  .sort((a, b) => a.localeCompare(b))
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading">{PROJECTS.TITLE}</h1>
      <p class="mt-2">{PROJECTS.DESCRIPTION}</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Projects client:only="solid-js" tags={tags} data={projects}>
        <Skeleton slot="fallback" variant="projects" />
      </Projects>
    </div>
  </BottomLayout>
</PageLayout>
