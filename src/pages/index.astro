---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"
import Clouds from "@components/Clouds.astro"
import TechCarousel from "@components/TechCarousel.astro"
import Skills from "@components/Skills.astro"
import ProjectCard from "@components/ProjectCard"
import { toProjectCard } from "@lib/projects"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,4)

const projectCards = await Promise.all(projects.map(toProjectCard))

const stats = [
  { value: "5+", label: "years building on Roblox" },
  { value: "270M+", label: "visits contributed to" },
  { value: "2", label: "years making websites" },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- Light Mode: Particles -->
  <div class='sky-parallax bg-gradient-w block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='sky-parallax bg-gradient-radial hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline data-astro-rerun src="/js/bg.js"></script>

  <!-- HERO -->
  <section class="relative h-screen w-full">
    <Clouds />
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px]'>
        <div id="planet" class='bg-planet w-full h-full bg-sky-50 dark:bg-black rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-20 rounded-full bg-neutral-900/25 dark:bg-white/25 blur-3xl'/>
        </div>
      </div>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='p-5 text-center'>
        <p class='text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
          Hello, I am
        </p>
        <h1 class='text-5xl md:text-6xl lg:text-7xl font-bold uppercase tracking-tight bg-gradient-to-b from-black to-black/60 dark:from-white dark:to-white/60 bg-clip-text text-transparent'>
          cobalt
        </h1>
        <p class='mt-2 text-sm md:text-base lg:text-lg opacity-75'>
          Currently designing games and websites.
        </p>
        <p class="text-sm md:text-base lg:text-lg opacity-75">
          Pursuing a degree in computer science / software engineering.
        </p>
        <div class='flex flex-wrap gap-4 justify-center mt-6'>
          <a href='/work' class='py-2 px-5 rounded-full truncate text-xs md:text-sm lg:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 shadow-lg shadow-sky-500/20 dark:shadow-indigo-400/20 blend'>
            View my work
          </a>
          <a href='/blog' class='py-2 px-5 rounded-full truncate text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 bg-white/30 dark:bg-white/5 backdrop-blur-sm hover:bg-black/5 hover:dark:bg-white/15 blend'>
            Read my blog
          </a>
        </div>
      </div>
    </div>
    <a href="#about" aria-label="Scroll to about section" class="absolute bottom-8 left-1/2 -translate-x-1/2 p-2 animate-bounce opacity-60 hover:opacity-100 blend">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </a>
  </section>

  <!-- Fades from the planet's color to transparent so the sky shows through behind the content -->
  <div class="relative bg-gradient-to-b from-sky-50 to-transparent to-[60vh] dark:from-black">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">

      <!-- About Section -->
      <section id="about" class="animate scroll-mt-24 space-y-6">
        <p>
          I am a <b class="text-black dark:text-white">game developer</b>, <b class="text-black dark:text-white">website developer</b>,
          sometimes a <b class="text-black dark:text-white">mentor</b>, and a <b class="text-black dark:text-white">student</b>.
          Right now I am creating fun and engaging games on Roblox, while also developing websites.
        </p>
        <div class="grid grid-cols-3 gap-3">
          {stats.map((stat) => (
            <div class="card card-hover p-4 text-center">
              <div class="text-2xl md:text-3xl font-bold text-black dark:text-white">{stat.value}</div>
              <div class="text-xs md:text-sm mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
        <p class="text-xs opacity-60">Visit count as of March 2026.</p>
      </section>
    </div>

    <!-- Tech Carousel (full width) -->
    <section class="animate pb-24">
      <TechCarousel />
    </section>

    <div class="mx-auto max-w-screen-sm p-5 pt-0 space-y-24 pb-16">

      <!-- Skill Set Section -->
      <section class="animate space-y-4">
        <p class="font-semibold text-black dark:text-white">Skill set</p>
        <Skills />
      </section>

      <!-- Blog Preview Section -->
      <section class="animate space-y-4">
        <div class="flex justify-between">
          <p class="font-semibold text-black dark:text-white">
            Recent posts
          </p>
          <a href="/blog" class="text-sm underline decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white underline-offset-2 hover:text-black dark:hover:text-white blend">
            All posts
          </a>
        </div>
        <ul class="space-y-4">
          {posts.map((post) => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Project Preview Section -->
      <section class="animate space-y-4">
        <div class="flex justify-between">
          <p class="font-semibold text-black dark:text-white">
            Recent projects
          </p>
          <a href="/projects" class="text-sm underline decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white underline-offset-2 hover:text-black dark:hover:text-white blend">
            All projects
          </a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {projectCards.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Contact Section -->
      <section class="animate space-y-4">
        <div>
          <p class="font-semibold text-black dark:text-white">
            Let's Connect
          </p>
          <p>
            Reach out to me via email or on social media.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {SOCIALS.map(social => (
            <a href={social.HREF} target="_blank" class="group card card-hover p-3 flex items-center gap-3">
              <span class="size-10 shrink-0 p-2 rounded-full bg-black/5 dark:bg-white/10 group-hover:bg-sky-200 dark:group-hover:bg-indigo-900 blend">
                <svg class="size-full fill-current">
                  <use href={`/social.svg#${social.ICON}`} />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-black dark:text-white">{social.NAME}</span>
                <span class="block text-sm truncate">{social.TEXT}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</PageLayout>
