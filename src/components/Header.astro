---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
import Container from "@components/Container.astro"
const iconBtn = "size-9 rounded-full p-2 items-center justify-center border border-transparent stroke-current text-current transition-all duration-300 ease-in-out hover:text-sky-700 dark:hover:text-sky-200 hover:stroke-sky-700 dark:hover:stroke-sky-200 hover:shadow-md hover:shadow-indigo-500/25 hover:[background:linear-gradient(#f0f9ff,#f0f9ff)_padding-box,linear-gradient(135deg,#38bdf8,#6366f1)_border-box] dark:hover:[background:linear-gradient(#0f172a,#0f172a)_padding-box,linear-gradient(135deg,#7dd3fc,#818cf8)_border-box] border-black/10 dark:border-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
const activeBtn = "pointer-events-none !border-transparent !text-white !stroke-white [background:linear-gradient(135deg,#0284c7,#4f46e5)!important] shadow-lg shadow-indigo-500/30"
const linkBase = "flex items-center justify-center rounded-full text-current transition-all duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
const linkActive = "bg-gradient-to-r from-sky-600 to-indigo-600 text-white shadow-lg shadow-indigo-500/30"
const linkIdle = "hover:bg-gradient-to-r hover:from-sky-500/15 hover:to-indigo-500/15 hover:text-sky-900 dark:hover:text-sky-100"
---

<header id="header" transition:animate="none" class="fixed top-0 w-full h-16 z-50 ">
  <Container size="md">
    <div class="relative h-full w-full">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 flex gap-1 font-semibold">
        <a href="/" class="flex gap-1 text-current bg-clip-text transition-all duration-300 ease-in-out hover:text-transparent hover:bg-gradient-to-r hover:from-sky-600 hover:to-indigo-600 dark:hover:from-sky-200 dark:hover:to-indigo-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded">
          <div>
            {SITE.TITLE}
          </div>
        </a>
      </div>

    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <nav class="hidden md:flex items-center justify-center text-sm gap-1 p-1 rounded-full border border-sky-200/60 dark:border-indigo-300/20 bg-white/60 dark:bg-slate-900/50 backdrop-blur-md shadow-lg shadow-sky-500/10 dark:shadow-indigo-500/10">
        {
          LINKS.map((LINK) => (
            <a href={LINK.HREF} class={cn(linkBase, "h-8 px-3", pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? linkActive : linkIdle)}>
              {LINK.TEXT}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-1">
      <a href="/search" aria-label={`Search blog posts and projects on ${SITE.TITLE}`} class={cn("hidden md:flex", iconBtn, pathname === "/search" || "/" + subpath?.[0] === "search" ? activeBtn : "")}>
        <svg class="size-full">
          <use href="/ui.svg#search"></use>
        </svg>
      </a>

      <a href="/rss.xml" target="_blank" aria-label={`Rss feed for ${SITE.TITLE}`} class={cn("hidden md:flex", iconBtn)}>
        <svg class="size-full">
          <use href="/ui.svg#rss"></use>
        </svg>
      </a>

      <button id="header-theme-button" aria-label={`Toggle light and dark theme`} class={cn("hidden md:flex", iconBtn)}>
        <svg class="size-full block dark:hidden">
          <use href="/ui.svg#sun"></use>
        </svg>
        <svg class="size-full hidden dark:block">
          <use href="/ui.svg#moon"></use>
        </svg>
      </button>

      <button id="header-drawer-button" aria-label={`Toggle drawer open and closed`} class={cn("flex md:hidden", iconBtn)}>
        <svg id="drawer-open" class="size-full">
          <use href="/ui.svg#menu"></use>
        </svg>
        <svg id="drawer-close" class="size-full">
          <use href="/ui.svg#x"></use>
        </svg>
      </button>
    </div>
  </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", () => {
      drawer?.classList.toggle("open")
      drawerButton.classList.toggle("open")
    })
  })
</script>
